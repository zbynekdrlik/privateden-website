---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { generateCSSVariables } from '../utils/theme'
import generalSettings from '../content/settings/general.json'
import contactData from '../content/settings/contact.json'
import { type Lang, DEFAULT_LANG, t } from '../utils/i18n'
import { getAllApartments } from '../utils/apartments'

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
}

const { title, description = "Rodinné ubytovanie v srdci Liptova", lang = DEFAULT_LANG, ogImage } = Astro.props;
const cssVariables = generateCSSVariables();
const siteName = generalSettings.siteName;
const siteUrl = 'https://privateden.sk';
const i18n = t(lang);
const apartments = getAllApartments();

// Build alternate language URLs
const pathWithoutLang = Astro.url.pathname.replace(/^\/(sk|pl|en)/, '') || '/';
const canonicalUrl = `${siteUrl}/${lang}${pathWithoutLang}`;
const ogImageUrl = ogImage || `${siteUrl}/images/og-default.jpg`;

// Structured data for the accommodation business
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": siteName,
  "url": siteUrl,
  "image": `${siteUrl}/images/og-default.jpg`,
  "telephone": generalSettings.phone,
  "email": generalSettings.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": contactData.address.street,
    "addressLocality": contactData.address.city,
    "postalCode": contactData.address.zip,
    "addressCountry": "SK"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 49.129322,
    "longitude": 19.5839577
  },
  "sameAs": [
    "https://www.google.com/maps/place/Apartment+Eden/@49.129322,19.5813828,671m/data=!3m1!1e3!4m9!3m8!1s0x4715986447fdcd5d:0x61bdc07874a82ab0!5m2!4m1!1i2!8m2!3d49.129322!4d19.5839577!16s%2Fg%2F1vzg0_06"
  ],
  "checkinTime": contactData.checkIn,
  "checkoutTime": contactData.checkOut,
  "numberOfRooms": 5,
  "petsAllowed": contactData.dogFriendly,
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Free WiFi", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Free Parking", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Hot Tub", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Playground", "value": true }
  ],
  "priceRange": "€38-€100",
  "makesOffer": apartments.map(apt => ({
    "@type": "Offer",
    "name": apt.name[lang] || apt.name.sk,
    "description": apt.description[lang] || apt.description.sk,
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "priceCurrency": "EUR",
      "price": apt.priceRange.min,
      "unitText": "NIGHT"
    },
    "eligibleQuantity": {
      "@type": "QuantitativeValue",
      "maxValue": apt.capacity,
      "unitText": "PERSON"
    }
  }))
});
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={i18n.seo.keywords} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="sk" href={`${siteUrl}/sk${pathWithoutLang}`} />
    <link rel="alternate" hreflang="pl" href={`${siteUrl}/pl${pathWithoutLang}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en${pathWithoutLang}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/sk${pathWithoutLang}`} />
    <title>{title} | {siteName}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : lang === 'pl' ? 'pl_PL' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={structuredData}></script>

    <style set:html={cssVariables}></style>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-background)] text-[var(--color-text)]">
    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
